# Frontend build settings (Vite). These values are public: they end up in the browser bundle.
# Production values live in .env.production or the Vercel project settings.

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Public origin of the website, used for canonical URLs, Open Graph, structured data, sitemap and robots.txt.
# Leave empty to omit all domain-dependent tags.
VITE_SITE_URL=
