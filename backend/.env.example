# Copy to backend/.env for local development. Never commit real values.
# In production, set these in the hosting dashboard (e.g. Render > Environment).

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Admin dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin session tokens (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=

# Comma-separated list of exact frontend origins allowed by CORS (no trailing slash)
FRONTEND_URL=https://dev.vultusgo.in,http://localhost:5173

# Set to "production" on the live server. Without FRONTEND_URL, production rejects all browser origins.
NODE_ENV=development

# Numeric port. Hosting platforms usually inject this automatically.
PORT=5000
